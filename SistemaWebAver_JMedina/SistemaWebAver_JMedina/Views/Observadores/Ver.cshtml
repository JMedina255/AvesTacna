
@model SistemaWebAver_JMedina.Models.Observadores

@{
    ViewBag.Title = "Detalle del observador";
}

<h2>Detalle del observador</h2>

<div class="card shadow-sm">
    <div class="card-header">
        Información del observador
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Código</dt>
            <dd class="col-sm-8">@Model.ObservadorId</dd>

            <dt class="col-sm-4">Nombres</dt>
            <dd class="col-sm-8">@Model.Nombres</dd>

            <dt class="col-sm-4">Apellidos</dt>
            <dd class="col-sm-8">@Model.Apellidos</dd>

            <dt class="col-sm-4">Nivel</dt>
            <dd class="col-sm-8">@Model.Nivel</dd>

            <dt class="col-sm-4">Fecha de ingreso</dt>
            <dd class="col-sm-8">@Model.FechaIngreso.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">Correo electrónico</dt>
            <dd class="col-sm-8">@Model.Email</dd>
        </dl>

        <hr />

        @Html.ActionLink(
            "Editar",
            "AgregarEditar",
            new { id = Model.ObservadorId },
            new { @class = "btn btn-primary me-2" })

        @Html.ActionLink(
            "Volver al listado",
            "Index",
            null,
            new { @class = "btn btn-secondary me-2" })

        <button type="button"
                class="btn btn-danger"
                data-bs-toggle="modal"
                data-bs-target="#modalEliminar">
            Eliminar
        </button>
    </div>
</div>

<div class="modal fade"
     id="modalEliminar"
     tabindex="-1"
     aria-labelledby="modalEliminarLabel"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEliminarLabel">
                    Confirmar eliminación
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>
            </div>

            <div class="modal-body">
                ¿Deseas eliminar a
                <strong>@Model.Nombres @Model.Apellidos</strong>?
                <p class="text-danger mt-2 mb-0">
                    Si tiene expediciones, avistamientos o una cuenta
                    asociada, el sistema puede impedir la eliminación.
                </p>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                @using (Html.BeginForm(
                    "Eliminar",
                    "Observadores",
                    new { id = Model.ObservadorId },
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger">
                        Confirmar eliminación
                    </button>
                }
            </div>
        </div>
    </div>
</div>
