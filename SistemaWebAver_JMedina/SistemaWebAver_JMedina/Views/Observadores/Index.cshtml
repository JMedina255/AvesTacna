
@model IEnumerable<SistemaWebAver_JMedina.Models.Observadores>

@{
    ViewBag.Title = "Observadores";
}

<div class="page-header">
    <h2>Observadores <small>@Model.Count() registrados</small></h2>
</div>

<div class="row mb-3">
    <div class="col-md-8">
        @using (Html.BeginForm("Index", "Observadores", FormMethod.Get))
        {
            <div class="input-group">
                <input type="text"
                       name="criterio"
                       class="form-control"
                       placeholder="Buscar por nombre, apellido, correo o nivel"
                       value="@ViewBag.Criterio" />

                <button class="btn btn-outline-secondary" type="submit">
                    Buscar
                </button>
            </div>
        }
    </div>

    <div class="col-md-4 text-md-end mt-2 mt-md-0">
        @Html.ActionLink(
            "+ Nuevo observador",
            "AgregarEditar",
            "Observadores",
            null,
            new { @class = "btn btn-success" })
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No se encontraron observadores.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Apellidos</th>
                    <th>Nombres</th>
                    <th>Nivel</th>
                    <th>Fecha de ingreso</th>
                    <th>Correo electrónico</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Apellidos</td>
                        <td>@item.Nombres</td>
                        <td>@item.Nivel</td>
                        <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                        <td>@item.Email</td>
                        <td>
                            @Html.ActionLink(
                                "Ver",
                                "Ver",
                                new { id = item.ObservadorId },
                                new { @class = "btn btn-sm btn-info me-1" })

                            @Html.ActionLink(
                                "Editar",
                                "AgregarEditar",
                                new { id = item.ObservadorId },
                                new { @class = "btn btn-sm btn-primary" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
