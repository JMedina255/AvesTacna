
@model SistemaWebAver_JMedina.Models.Observadores

@{
    bool esEdicion = Model.ObservadorId > 0;
    ViewBag.Title = esEdicion ? "Editar observador" : "Nuevo observador";
}

<h2>@ViewBag.Title</h2>

<div class="card shadow-sm">
    <div class="card-header">
        Datos del observador
    </div>

    <div class="card-body">
        @using (Html.BeginForm("Guardar", "Observadores", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ObservadorId)

            @Html.ValidationSummary(
                false,
                "",
                new { @class = "text-danger mb-3" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Nombres, "Nombres", new { @class = "form-label" })
                @Html.TextBoxFor(
                    m => m.Nombres,
                    new { @class = "form-control", maxlength = "60" })
                @Html.ValidationMessageFor(
                    m => m.Nombres,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Apellidos, "Apellidos", new { @class = "form-label" })
                @Html.TextBoxFor(
                    m => m.Apellidos,
                    new { @class = "form-control", maxlength = "80" })
                @Html.ValidationMessageFor(
                    m => m.Apellidos,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Nivel, "Nivel", new { @class = "form-label" })
                @Html.TextBoxFor(
                    m => m.Nivel,
                    new { @class = "form-control", maxlength = "15" })
                @Html.ValidationMessageFor(
                    m => m.Nivel,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.FechaIngreso, "Fecha de ingreso", new { @class = "form-label" })
                @Html.TextBoxFor(
                    m => m.FechaIngreso,
                    "{0:yyyy-MM-dd}",
                    new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(
                    m => m.FechaIngreso,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Email, "Correo electrónico", new { @class = "form-label" })
                @Html.TextBoxFor(
                    m => m.Email,
                    new { @class = "form-control", type = "email", maxlength = "100" })
                @Html.ValidationMessageFor(
                    m => m.Email,
                    "",
                    new { @class = "text-danger" })
            </div>

            <hr />

            <button type="submit" class="btn btn-success">
                @(esEdicion ? "Guardar cambios" : "Registrar observador")
            </button>

            @Html.ActionLink(
                "Cancelar",
                "Index",
                "Observadores",
                null,
                new { @class = "btn btn-secondary ms-2" })
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
