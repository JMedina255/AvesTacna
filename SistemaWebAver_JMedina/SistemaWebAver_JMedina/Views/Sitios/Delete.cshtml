@model SistemaWebAver_JMedina.Models.Sitios
@{
    ViewBag.Title = "Eliminar sitio";
}
<h2>Eliminar sitio</h2>
<div class="alert alert-warning">
    <strong>¿Está seguro de que desea eliminar este sitio?</strong> Esta acción no se puede deshacer.
</div>
<dl class="dl-horizontal">
    <dt>@Html.DisplayNameFor(m => m.Nombre)</dt>
    <dd>@Html.DisplayFor(m => m.Nombre)</dd>
    <dt>@Html.DisplayNameFor(m => m.Tipo)</dt>
    <dd><span class="label label-info">@Model.Tipo</span></dd>
    <dt>@Html.DisplayNameFor(m => m.Provincia)</dt>
    <dd>@Html.DisplayFor(m => m.Provincia)</dd>
    <dt>@Html.DisplayNameFor(m => m.AltitudMsnm)</dt>
    <dd>@Model.AltitudMsnm.ToString("N0")</dd>
</dl>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Eliminar" class="btn btn-danger" />
    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default" })
}